{
  "name": "jharness",
  "productName": "JHarness",
  "version": "0.1.0",
  "private": true,
  "main": "apps/desktop/electron/main.cjs",
  "scripts": {
    "build:ui": "vite build --config apps/ui/vite.config.mjs",
    "cli": "node apps/cli/jharness-cli.cjs",
    "start": "electron .",
    "package:win": "npm run build:ui && node packaging/windows/package.cjs && node tests/packaged-app/smoke.cjs",
    "verify:release": "node packaging/windows/verify-release.cjs",
    "test:packaged-recovery": "node tests/packaged-app/smoke.cjs --recovery",
    "test": "node --test apps/desktop/test/*.test.cjs tests/e2e/*.test.cjs tests/budgets/*.test.cjs",
    "check:budgets": "node --test tests/budgets/*.test.cjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "lucide-react": "0.562.0"
  },
  "devDependencies": {
    "electron": "42.0.0",
    "vite": "7.3.1"
  }
}
